# Example settings. The gateway reads the process environment and does not load
# .env files; set these in your shell (see "Run it" in README.md).
# Copy to .env for your own notes if you like; .env is gitignored. Never commit a key.

# Path to the TOML config with provider instances and model aliases (D-044).
# Unset: the built-in mock-only default. Examples: config/providers.toml,
# config/mock-fallback.toml. LLMGATEWAY_PROVIDER is no longer read; if it is set,
# startup stops. Leave it unset rather than empty: an empty value stops startup.
# LLMGATEWAY_CONFIG=config/providers.toml

# Fails mock instances on demand, for load tests (D-064). It can only name mock
# instances: with any other instance, startup stops. Leave it unset rather than
# empty: an empty value stops startup. This example, for config/mock-fallback.toml,
# fails every call to that instance from 60 s after its first call, for 30 s.
# LLMGATEWAY_FAULTS=mock-primary=1.0@60+30

# Required: the Postgres that holds the hashed API keys (D-091). A postgresql:// or
# postgres:// URL with a host; it holds a password, so it is never printed. Startup
# stops if it is missing or malformed, but not if Postgres is down: requests then get
# 503 auth_unavailable until it answers. This example is the Compose stack's
# development default, reachable only from inside the Compose network.
# LLMGATEWAY_DATABASE_URL=postgresql://llmgateway:llmgateway-dev-only@postgres:5432/llmgateway

# How long each worker caches a key's row, in seconds, from 0 to 60 (D-090). Unset
# means 10. A revoked key keeps working for up to this long; 0 turns the cache off.
# LLMGATEWAY_KEY_CACHE_SECONDS=10

# Required only when the config has a provider of type claude.
ANTHROPIC_API_KEY=

# Required only when the config has a provider of type gemini.
GEMINI_API_KEY=
